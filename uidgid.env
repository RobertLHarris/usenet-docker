PUID=1000
PGID=100
#
#UMASK=022
UMASK=000
#
TZ=America/Denver
ENABLE_IPV6=true
VIRTUAL_HOST=helheim.rdlg.net
#
# Sabnzbd
#
SABNZBD_UID=1000
SABNZBD_GID=100
EDGE=1
#
LOG_LEVEL=${LOG_LEVEL:-info}
LOG_HTML=${LOG_HTML:-false}
# Flaresolver
CAPTCHA_SOLVER=${CAPTCHA_SOLVER:-hcaptcha-solver}
#
# Transmission
#
# No longer supported
#TRANSMISSION_WEB_HOME=/flood-for-transmission/
#blocklist-enabled=true
