# WatchTower
#
WATCHTOWER_CLEANUP=true
WATCHTOWER_POLL_INTERVAL=300
# 
# TDARR
#
log-opt="max-size=10m" 
log-opt="max-file=5"
serverPort=8266
webUIPort=8265
serverIP=0.0.0.0


